PORT=4000

# Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay keys. The backend returns RAZORPAY_KEY_ID to the browser only when creating an order.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Optional first super admin login. You can also insert super admins into the super_admins table.
SUPER_ADMIN_EMAIL=admin@unitap.com
SUPER_ADMIN_PASSWORD=ChangeMe@123
SUPER_ADMIN_NAME=UniTap Super Admin
