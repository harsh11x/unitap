PORT=4000

# Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The backend also accepts frontend-style names when you only have a publishable key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Razorpay keys. The backend returns RAZORPAY_KEY_ID to the browser only when creating an order.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Used to sign short-lived payment box connection tokens.
DEVICE_TOKEN_SECRET=replace-with-a-long-random-string

# Optional first super admin login. You can also insert super admins into the super_admins table.
SUPER_ADMIN_EMAIL=admin@unitap.com
SUPER_ADMIN_PASSWORD=ChangeMe@123
SUPER_ADMIN_NAME=UniTap Super Admin
